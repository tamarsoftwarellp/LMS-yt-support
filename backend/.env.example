APP_NAME=EduConnect API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/educonnect
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-secret-before-production
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# OpenAI is temporarily disabled.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5
ASSIGNMENT_UPLOAD_DIR=uploads/assignments
COLLEGE_LOGO_UPLOAD_DIR=uploads/college-logos
MAX_ASSIGNMENT_SIZE_MB=50
PUBLIC_APP_URL=http://localhost:5173
# Bootstrap LMS Admin (used by scripts/create_admin.py)
ADMIN_EMAIL=lms-admin@example.com
ADMIN_PASSWORD=ReplaceWithStrongPassword123
ADMIN_MOBILE=9876543210
